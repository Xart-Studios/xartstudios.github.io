<!DOCTYPE html>
<html lang="en">
<head>

  <!-- 🔥 Basic SEO -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Xartstudios | Creative Digital Studio</title>
  <meta name="description" content="Xartstudios is a creative digital studio specializing in web design, branding, filmmaking, photography, and cinematic digital experiences.">
  <meta name="keywords" content="Xartstudios, web design, branding, filmmaking, photography, creative studio, digital agency">
  <meta name="author" content="Xartstudios">

  <!-- 🌍 Open Graph (Social Sharing) -->
  <meta property="og:title" content="Xartstudios | Creative Digital Studio">
  <meta property="og:description" content="Modern creative studio for web design, branding, and cinematic storytelling.">
  <meta property="og:type" content="website">

  <!-- 🎨 Style -->
  <style>
    body{
      margin:0;
      font-family:Arial;
      background:#0a0a0a;
      color:white;
      text-align:center;
    }

    header{
      height:100vh;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      background:linear-gradient(180deg,#000,#111);
    }

    h1{
      font-size:60px;
      color:#00ffd5;
      margin:0;
      letter-spacing:3px;
    }

    p{
      font-size:20px;
      color:#cccccc;
      max-width:600px;
    }

    .btn{
      margin-top:20px;
      padding:12px 30px;
      background:#00ffd5;
      color:black;
      border:none;
      border-radius:10px;
      font-size:16px;
      cursor:pointer;
